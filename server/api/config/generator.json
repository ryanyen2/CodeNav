{
  "default_provider": "openai",
  "providers": {
    "openai": {
      "client_class": "OpenAIClient",
      "default_model": "gpt-4o-mini",
      "supportsCustomModel": true,
      "models": {
        "gpt-4o-mini": { "temperature": 0.7, "top_p": 0.8 },
        "gpt-4o": { "temperature": 0.7, "top_p": 0.8 },
        "gpt-4": { "temperature": 0.7, "top_p": 0.8 }
      }
    },
    "ollama": {
      "client_class": "OllamaClient",
      "default_model": "llama3.2:3b",
      "supportsCustomModel": true,
      "models": {
        "llama3.2:3b": { "options": { "temperature": 0.7, "top_p": 0.8, "num_ctx": 8192 } },
        "qwen2.5:7b": { "options": { "temperature": 0.7, "top_p": 0.8, "num_ctx": 8192 } }
      }
    }
  }
}
