.env
.env.*

# .codoc/ is governed by the .gitignore that `codoc init` writes inside it.

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.venv*/
build/
dist/

# Dev tools
.DS_Store
.idea/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Personal editor settings (launch.json + tasks.json are shared/tracked;
# settings.json holds machine-local overrides like codoc.serverPath).
.vscode/settings.json

# Claude Code
.claude/
.agents/
.cursor/
.copilot/

uv.lock


.hypothesis/

node_modules

# Bundled Python wheel — a build artifact produced by scripts/bundle-wheel.mjs
# at VSIX package time; shipped inside the .vsix, never committed.
vscode-codoc/bundled/*.whl

# Packaged extension — a build artifact produced by `vsce package`, never committed.
vscode-codoc/*.vsix

# Real-world corpora for trying codoc end to end (requests/, nanochat/, …); local
# only. Anchored so it does not match vscode-codoc/src/test/.
/test/


review.md