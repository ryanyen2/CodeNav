.env
.env.*

# codoc — share the AUTHORED INTENT, keep the DERIVED state local.
# Commit `tree.codoc` (and the webview's `tree.doc.json`): the feature tree is the
# team's shared intent map, versioned with the code. Everything else under .codoc/
# (the chunk index, the SQLite db + event log, and the transient control files) is
# rebuilt per checkout by `codoc init` / `codoc watch`, so it is NOT committed.
# (To also share the binding db, force-add it: `git add -f .codoc/codoc.db`.)
**/.codoc/*
!**/.codoc/tree.codoc
!**/.codoc/tree.doc.json

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.venv*/
build/
dist/

# Dev tools
.DS_Store
.idea/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Personal editor settings (launch.json + tasks.json are shared/tracked;
# settings.json holds machine-local overrides like codoc.serverPath).
.vscode/settings.json

# Claude Code
.claude/
.agents/
.cursor/
.copilot/

uv.lock


.hypothesis/

node_modules/
dist/

# Bundled Python wheel — a build artifact produced by scripts/bundle-wheel.mjs
# at VSIX package time; shipped inside the .vsix, never committed.
vscode-codoc/bundled/*.whl

# Packaged extension — a build artifact produced by `vsce package`, never committed.
vscode-codoc/*.vsix

# Root-level real-world corpora only (requests/, altair/, …); anchored so it does
# NOT swallow nested source test dirs like vscode-codoc/src/test/.
/test/