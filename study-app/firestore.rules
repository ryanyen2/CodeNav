rules_version = '2';

// Security rules for the codoc study.
//
// The web configuration in the apps is public by design. It identifies the
// project and protects nothing. This file is the protection, and
// test/rules.test.js is the proof, including the negative cases.
//
// The shape:
//   - Experimenters sign in with Google and must be on the allowlist below.
//     They can read everything and write their own assessments.
//   - A participant has a long random code, created in advance. Two writers work
//     under it: the page in their browser and the mirror inside their editor.
//     Each signs in anonymously and registers itself in a named slot.
//     Naming the slots makes the limit structural, so these rules never count.
//   - Nothing anywhere may carry a name, an email, or anything else identifying.
//     Consent is collected in a Google Form and those fields stay there.

service cloud.firestore {
  match /databases/{database}/documents {

    // Add addresses here to grant an experimenter access. Nothing else grants it.
    function allowlist() {
      return ['ryanyen2@mit.edu'];
    }

    // Reads the token defensively. An anonymous account has no email claim at
    // all, and touching a missing property is an evaluation error rather than a
    // plain false. Errors deny, so the effect is the same here, but they poison
    // any expression this sits inside and they fill the logs with noise that
    // hides real failures. get() with a default keeps it an ordinary false.
    function isExperimenter() {
      return request.auth != null
          && request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', '') in allowlist();
    }

    // The two writers under a participant code. A fourth name is not a slot.
    function isSlot(slot) {
      return slot in ['browser', 'mirror'];
    }

    // The setup script's slot, which is not a writer and is not claim-once.
    //
    // It only ever reads: the script signs in anonymously, takes this slot, reads
    // the keys, and keeps nothing — no refresh token, no stored uid. So every run
    // arrives as a different account, and a claim-once slot would lock a
    // participant out of their own keys the second time they run setup, which is
    // exactly when somebody is stuck and re-running it.
    function isFetchSlot(slot) {
      return slot == 'setup';
    }

    // A day of silence. Slots older than this are treated as abandoned, and the
    // two ways a slot says it is alive are both read, because only the mirror
    // writes lastSeenAt and every slot writes registeredAt when it is claimed.
    // Reading registeredAt as well is what stops a browser slot claimed an hour
    // ago from being taken by anybody else holding the code.
    function abandonedBefore() {
      return request.time.toMillis() - 86400000;
    }

    function participantExists(code) {
      return exists(/databases/$(database)/documents/participants/$(code));
    }

    function participantOpen(code) {
      return participantExists(code)
          && get(/databases/$(database)/documents/participants/$(code)).data.released != true;
    }

    // Whether the caller holds one of this code's slots. Two reads at most.
    function holdsSlot(code, slot) {
      return exists(/databases/$(database)/documents/participants/$(code)/devices/$(slot))
          && get(/databases/$(database)/documents/participants/$(code)/devices/$(slot)).data.uid
             == request.auth.uid;
    }

    function isDevice(code) {
      return request.auth != null
          && (holdsSlot(code, 'browser') || holdsSlot(code, 'mirror'));
    }

    // Consent lives in the Google Form. Nothing identifying reaches this database,
    // and that holds for experimenters too — it is about where the data lives, not
    // about who is trusted.
    function noIdentifyingFields() {
      return !request.resource.data.keys().hasAny([
        'name', 'fullName', 'firstName', 'lastName',
        'email', 'emailAddress',
        'phone', 'address', 'dob', 'dateOfBirth', 'ip'
      ]);
    }

    // The two keys the study pays for, entered once by the experimenter.
    //
    // A participant's setup script fetches its own copy with the code, so
    // nobody ever pastes a key. That is the point: a key that has to be copied
    // by hand is a key that ends up in the wrong window, and the copying is the
    // step that fails on a call.
    //
    // The price is stated rather than hidden: anything holding a participant
    // link can read that participant's copy. So these must be keys issued FOR
    // the study, with a hard spend cap, revoked when the sessions end. The
    // dashboard has a Revoke button per participant for the day one leaks.
    match /settings/{name} {
      allow read, write: if isExperimenter();
    }

    // Who a code belongs to, kept in its own collection.
    //
    // The one place identifying detail is allowed, and it is deliberately NOT a
    // field on the participant: everything under `participants` is what gets
    // exported and handed to whoever analyses it, and a name on that document
    // would travel with the session data by default. Here it has to be asked for
    // separately, and the export never does.
    //
    // Only an experimenter can read or write it. A participant holding their own
    // code cannot, which matters because the code is the credential everywhere
    // else and this is the one thing it must not open.
    match /contacts/{code} {
      allow read, write: if isExperimenter();
    }

    match /participants/{code} {
      allow get, list: if isExperimenter();
      allow create, update: if isExperimenter() && noIdentifyingFields();
      // Deleting a participant is how a code created by mistake, or a session
      // that must not exist, goes away. Only an experimenter, and everything
      // under it has to be removed first — the rules cannot cascade, so the
      // dashboard clears the subcollections before this.
      allow delete: if isExperimenter();

      // Registering a device. Anyone holding the code may take a free slot on a
      // participant that exists and has not been released. The code is the
      // credential, which is why it is long, random, and never shown publicly.
      match /devices/{slot} {
        allow get: if isExperimenter() || (request.auth != null
                      && resource.data.uid == request.auth.uid);
        allow list: if isExperimenter();
        allow create: if request.auth != null
                      && (isSlot(slot) || isFetchSlot(slot))
                      && participantOpen(code)
                      && request.resource.data.uid == request.auth.uid
                      && noIdentifyingFields();
        // A writer slot is claimed once, and releasing it is the experimenter's
        // job, which is how a participant who lost their browser storage gets
        // back in. Three exceptions are allowed, and each one exists because a
        // participant was otherwise locked out of their own code.
        //
        // First, the setup slot is retaken on every run, because setup is meant
        // to be safe to run again and its account is thrown away each time. It
        // grants no more than a free slot already would.
        //
        // Second, the machine that holds a writer slot may write over it, which
        // is how the mirror records the time it was last heard from. A researcher
        // can then tell a machine that is still sending from one that registered
        // once and stopped, and those two look identical without it.
        //
        // Third, anybody holding the code may take a writer slot whose holder has
        // not been heard from for a day. The case that made it necessary is a
        // pilot run or a test run that signed in as a throwaway account, claimed
        // the mirror slot, and exited, after which the person who sat down next
        // had every batch under their own code refused and only the experimenter
        // could repair it. A day is long enough that a second machine which is
        // genuinely in use cannot take the slot from the first. A slot written
        // before the heartbeat existed carries no lastSeenAt, reads as zero, and
        // is therefore reclaimable as soon as the day has passed since it was
        // claimed, which is the repair we want for the codes already spent.
        allow update: if isExperimenter()
                      || (request.auth != null
                          && isFetchSlot(slot)
                          && participantOpen(code)
                          && request.resource.data.uid == request.auth.uid
                          && noIdentifyingFields())
                      || (request.auth != null
                          && isSlot(slot)
                          && participantOpen(code)
                          && request.resource.data.uid == request.auth.uid
                          && noIdentifyingFields()
                          && (resource.data.uid == request.auth.uid
                              || (resource.data.get('lastSeenAt', 0) < abandonedBefore()
                                  && resource.data.get('registeredAt', 0) < abandonedBefore())));
        allow delete: if isExperimenter();
      }

      // This participant's copy of the keys. Readable by their own registered
      // devices and by nobody else — not by another participant, not by a
      // stranger with the collection path.
      match /secrets/{name} {
        allow read: if isExperimenter()
                    || isDevice(code)
                    || (request.auth != null && holdsSlot(code, 'setup'));
        allow write: if isExperimenter();
      }

      match /answers/{form} {
        allow read: if isExperimenter();
        allow create, update: if isDevice(code) && noIdentifyingFields();
        allow delete: if false;
      }

      match /sessions/{condition} {
        allow read: if isExperimenter();
        allow create, update: if isDevice(code) && noIdentifyingFields();
        allow delete: if false;

        // Append only. A batch that has been written is never edited, so a
        // replay after a crash cannot quietly rewrite history.
        match /batches/{batchId} {
          allow read: if isExperimenter();
          allow create: if isDevice(code) && noIdentifyingFields();
          allow update, delete: if false;
        }
      }

      // Written by the experimenter alone, kept in its own collection so that
      // neither side can overwrite the other and these rules stay readable.
      match /assessments/{condition} {
        allow read: if isExperimenter();
        allow create, update: if isExperimenter() && noIdentifyingFields();
        allow delete: if false;
      }
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
