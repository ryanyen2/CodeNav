{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "codoc",
  "scopeName": "source.codoc",
  "patterns": [
    { "include": "#pending-sentinel" },
    { "include": "#diff-add" },
    { "include": "#diff-retire" },
    { "include": "#diff-move" },
    { "include": "#comment" },
    { "include": "#retired-feature" },
    { "include": "#feature" },
    { "include": "#id-marker" },
    { "include": "#inline-ref" }
  ],
  "repository": {
    "comment": {
      "match": "^\\s*#.*$",
      "name": "comment.line.number-sign.codoc"
    },
    "pending-sentinel": {
      "match": "^#\\s*──\\s*pending changes.*$",
      "name": "comment.line.number-sign.codoc"
    },
    "diff-add": {
      "match": "^(\\+)( .*)$",
      "captures": {
        "1": { "name": "markup.inserted.codoc punctuation.definition.inserted" },
        "2": { "name": "markup.inserted.codoc" }
      }
    },
    "diff-retire": {
      "match": "^(-)( [-~] .*)$",
      "captures": {
        "1": { "name": "markup.deleted.codoc punctuation.definition.deleted" },
        "2": { "name": "markup.deleted.codoc" }
      }
    },
    "diff-move": {
      "match": "^(~)( [-~] .*)$",
      "captures": {
        "1": { "name": "markup.changed.codoc punctuation.definition.changed" },
        "2": { "name": "markup.changed.codoc" }
      }
    },
    "feature": {
      "patterns": [
        { "match": "^(- ).*$", "name": "entity.name.section.codoc.h1" },
        { "match": "^  (- ).*$", "name": "entity.name.section.codoc.h2" },
        { "match": "^    (- ).*$", "name": "entity.name.section.codoc.h3" },
        { "match": "^      (- ).*$", "name": "entity.name.section.codoc.h4" },
        { "match": "^        (- ).*$", "name": "entity.name.section.codoc.h5" }
      ]
    },
    "retired-feature": {
      "match": "^\\s*(~)\\s+([^⟨#]+).*$",
      "captures": {
        "1": { "name": "invalid.deprecated.codoc" },
        "2": { "name": "invalid.deprecated.codoc" }
      }
    },
    "id-marker": {
      "match": "⟨[^⟩]+⟩",
      "name": "comment.other.id.codoc"
    },
    "inline-ref": {
      "match": "(\\[)([^\\]]*)(\\])(\\()(codoc:[^)]+)(\\))",
      "captures": {
        "1": { "name": "punctuation.definition.string.begin.codoc" },
        "2": { "name": "string.other.link.title.codoc" },
        "3": { "name": "punctuation.definition.string.end.codoc" },
        "4": { "name": "punctuation.definition.metadata.codoc" },
        "5": { "name": "markup.underline.link.codoc" },
        "6": { "name": "punctuation.definition.metadata.codoc" }
      }
    }
  }
}
