{
  "name": "codoc",
  "displayName": "codoc",
  "description": "Feature-tree navigator and transaction queue for codoc",
  "version": "0.2.18",
  "publisher": "codoc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanyen2/CodeNav.git",
    "directory": "vscode-codoc"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Tree navigation works untrusted; setup, provisioning, and the watch daemon require trust."
    }
  },
  "contributes": {
    "menus": {
      "commandPalette": [
        {
          "command": "codoc.navigateToFeature",
          "when": "false"
        }
      ]
    },
    "languages": [
      {
        "id": "codoc",
        "aliases": [
          "Codoc",
          "codoc"
        ],
        "extensions": [
          ".codoc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "codoc",
        "scopeName": "source.codoc",
        "path": "./syntaxes/codoc.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "codoc.tree-editor",
        "displayName": "Codoc Tree",
        "selector": [
          {
            "filenamePattern": "**/.codoc/tree.codoc"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "codoc.setup",
        "title": "codoc: Set up codoc"
      },
      {
        "command": "codoc.startDaemon",
        "title": "codoc: Start the daemon"
      },
      {
        "command": "codoc.sync",
        "title": "codoc: Sync"
      },
      {
        "command": "codoc.realize",
        "title": "codoc: Implement queued changes now"
      },
      {
        "command": "codoc.serve.start",
        "title": "codoc: Share — start the deployed hub (browser editor)"
      },
      {
        "command": "codoc.serve.startTunnel",
        "title": "codoc: Share remotely — start the hub over a tunnel"
      },
      {
        "command": "codoc.serve.stop",
        "title": "codoc: Stop the deployed hub"
      },
      {
        "command": "codoc.open",
        "title": "codoc: Open"
      },
      {
        "command": "codoc.navigateToFeature",
        "title": "codoc: Navigate to feature"
      },
      {
        "command": "codoc.find",
        "title": "codoc: Find in Tree"
      },
      {
        "command": "codoc.replace",
        "title": "codoc: Replace in Tree"
      }
    ],
    "keybindings": [
      {
        "command": "codoc.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == 'codoc.tree-editor'"
      },
      {
        "command": "codoc.replace",
        "key": "ctrl+h",
        "mac": "cmd+alt+f",
        "when": "activeCustomEditorId == 'codoc.tree-editor'"
      }
    ],
    "configuration": {
      "title": "codoc",
      "properties": {
        "codoc.rootDir": {
          "type": "string",
          "default": "",
          "description": "Root directory of the codoc-initialized repo. Auto-detected from workspace if empty."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "codocSetup",
        "title": "Get started with codoc",
        "description": "Provision codoc and open your codebase as a navigable feature tree — in one click.",
        "steps": [
          {
            "id": "setup",
            "title": "Set up codoc",
            "description": "Install the Python core, index your repo, and start the managed daemon — no terminal, no manual pip.\n[Set up codoc](command:codoc.setup)",
            "media": {
              "markdown": "media/walkthrough/setup.md"
            },
            "completionEvents": [
              "onContext:codoc.ready"
            ]
          },
          {
            "id": "open-tree",
            "title": "Open your feature tree",
            "description": "Navigate your codebase as a tree of intent — jump to code, author titles/descriptions, steer the agent.\n[Open your feature tree](command:codoc.open)",
            "media": {
              "markdown": "media/walkthrough/open-tree.md"
            },
            "completionEvents": [
              "onCommand:codoc.open"
            ]
          }
        ]
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "compile": "npm run build",
    "watch": "node esbuild.config.mjs --watch",
    "bundle-wheel": "node scripts/bundle-wheel.mjs",
    "vscode:prepublish": "npm run build && npm run bundle-wheel",
    "test": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/suggestion": "^2.27.2",
    "animejs": "^4.4.1"
  }
}
