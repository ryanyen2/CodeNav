{
  "name": "codenav-semantic-tree",
  "version": "0.1.0",
  "description": "Parser and tree-diff for prescriptive semantic tree (codebase intent)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npx tsx node_modules/tape/bin/tape 'test/**/*.test.ts'",
    "test:extract-fixtures": "node scripts/extract-test-cases.mjs",
    "parse:tree": "npx tsx src/cli/parse-tree.ts",
    "parse:test": "npx tsx src/cli/parse-test-case.ts",
    "parse:codebase": "npx tsx src/cli/parse-codebase.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tape": "^5.6.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
